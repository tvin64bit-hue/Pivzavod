---
import Logo from './Logo.astro';
import { footerNav, contacts, copyright, site } from '../data/site';
---

<footer class="ftr grain">
  <div class="container ftr__inner">
    <div class="ftr__col ftr__col--brand">
      <Logo compact />
      <p class="caption ftr__about">
        Крафтовая пивоварня в Челябинске с {site.foundedYear} года. Живое нефильтрованное
        пиво собственного производства, дегустационный зал и экспериментальные варки.
      </p>
      <ul class="ftr__social">
        <li><a href="https://piv-souz.ru" target="_blank" rel="noopener noreferrer">Союз пивоваров Южного Урала ↗</a></li>
      </ul>
    </div>

    <nav class="ftr__col ftr__col--map" aria-label="Карта сайта">
      <div class="ftr__map">
        {footerNav.map((group) => (
          <div class="ftr__group">
            <h2 class="label">{group.title}</h2>
            <ul>
              {group.items.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </nav>

    <div class="ftr__col ftr__col--contacts">
      <h2 class="label">Контакты</h2>
      <address class="ftr__address">
        <p>{contacts.addressFull}</p>
        <p><a href={contacts.officePhone.href}>{contacts.officePhone.label}</a></p>
        <p class="caption">{contacts.officeHours}</p>
      </address>
      <p class="caption mono ftr__req">
        ООО «Лаборатория живого пива»<br />
        ОГРН 1107451011117 · ИНН 7451305093
      </p>
    </div>
  </div>

  <div class="container ftr__bottom">
    <p class="caption">{copyright}</p>
    <span class="ftr__age" aria-label="Восемнадцать лет и старше">18+</span>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    background: var(--c-surface);
    border-top: 1px solid var(--c-border);
    padding-block: var(--s-16) var(--s-8);
    margin-top: var(--s-24);
  }
  .ftr > * { position: relative; z-index: 2; }

  .ftr__inner {
    display: grid;
    grid-template-columns: 1.1fr 1.6fr 1fr;
    gap: var(--s-12);
  }
  .ftr__about { margin-top: var(--s-4); max-width: 40ch; }

  .ftr__map {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-8);
  }
  .ftr__group ul,
  .ftr__social {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ftr__group li,
  .ftr__social li { margin-bottom: 0; }
  /* inline-block с вертикальными отступами: строка 14px даёт цель нажатия
     26px по высоте вместо 16px — палец на телефоне не промахивается */
  .ftr__group a,
  .ftr__social a,
  .ftr__address a {
    display: inline-block;
    padding-block: 5px;
    color: var(--c-muted);
    font-size: 14px;
    text-decoration: none;
  }
  .ftr__group a:hover,
  .ftr__social a:hover,
  .ftr__address a:hover { color: var(--c-accent); }
  .ftr__social { margin-top: var(--s-6); }

  .ftr__address { font-style: normal; }
  .ftr__address p { margin-bottom: var(--s-1); font-size: 14px; color: var(--c-muted); }
  .ftr__req { margin-top: var(--s-6); font-size: 12px; line-height: 20px; }

  .ftr__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    margin-top: var(--s-16);
    padding-top: var(--s-6);
    border-top: 1px solid var(--c-border);
  }
  .ftr__age {
    flex: none;
    font-family: var(--f-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--c-muted);
    border: 1px solid var(--c-border);
    border-radius: var(--r-sm);
    padding: 6px 10px;
  }

  @media (max-width: 1023px) {
    .ftr__inner { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ftr__col--map { grid-column: 1 / -1; order: 3; }
  }
  @media (max-width: 767px) {
    .ftr__inner { grid-template-columns: minmax(0, 1fr); gap: var(--s-8); }
    .ftr__col--map { order: 0; }
    .ftr__map { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6); }
    .ftr__bottom { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 480px) {
    .ftr__map { grid-template-columns: minmax(0, 1fr); }
  }
</style>
