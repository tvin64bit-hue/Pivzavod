---
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  label?: string;
  title: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
}
const { label, title, lead, crumbs = [] } = Astro.props;
---

<section class="page-head grain">
  <div class="container">
    {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
    {label && <p class="label">{label}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>

<style>
  .page-head {
    position: relative;
    padding-block: var(--s-16) var(--s-12);
    border-bottom: 1px solid var(--c-border);
    background:
      radial-gradient(120% 140% at 12% 0%, rgba(244, 169, 59, 0.13), transparent 58%),
      var(--c-bg);
  }
  .page-head > * { position: relative; z-index: 2; }
  .page-head h1 { margin-bottom: var(--s-6); max-width: 22ch; }
  .page-head h1:last-child { margin-bottom: 0; }

  @media (max-width: 767px) {
    .page-head { padding-block: var(--s-12) var(--s-8); }
  }
</style>
