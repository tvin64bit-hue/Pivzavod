---
/**
 * Логотип-wordmark. Отдельного файла на доноре нет (раздел 8 ТЗ),
 * собран по дизайн-системе: Fraunces, #F4A93B / #FAF3E8 на тёмном фоне.
 * Знак — стилизованная колба, отсылка к «Лаборатории».
 */
interface Props {
  /** Компактный вариант для футера и уменьшённой шапки */
  compact?: boolean;
  class?: string;
}
const { compact = false, class: className = '' } = Astro.props;
---

<span class:list={['wordmark', compact && 'wordmark--compact', className]}>
  <svg class="wordmark__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path
      d="M13 4h6M14 4v8.2L7.6 24.4A2.6 2.6 0 0 0 9.9 28h12.2a2.6 2.6 0 0 0 2.3-3.6L18 12.2V4"
      fill="none" stroke="currentColor" stroke-width="1.5"
      stroke-linecap="round" stroke-linejoin="round"
    />
    <path d="M10.4 20h11.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.55" />
  </svg>
  <span class="wordmark__text">
    <span class="wordmark__lab">Лаборатория</span>
    <span class="wordmark__beer">живого пива</span>
  </span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--c-accent);
    text-decoration: none;
    line-height: 1;
  }
  .wordmark__mark {
    width: 32px;
    height: 32px;
    flex: none;
    transition: transform var(--t-fast);
  }
  a:hover .wordmark__mark { transform: rotate(-8deg); }

  .wordmark__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--f-display);
    font-weight: 600;
  }
  .wordmark__lab {
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-accent);
  }
  .wordmark__beer {
    font-size: 20px;
    letter-spacing: -0.01em;
    color: var(--c-text);
    white-space: nowrap;
  }

  .wordmark--compact .wordmark__mark { width: 26px; height: 26px; }
  .wordmark--compact .wordmark__beer { font-size: 17px; }
  .wordmark--compact .wordmark__lab { font-size: 10px; }

  @media (max-width: 480px) {
    .wordmark__mark { width: 26px; height: 26px; }
    .wordmark__beer { font-size: 17px; }
  }
</style>
