---
/**
 * Интерактивная карта. Яндекс.Карты через iframe-виджет — без API-ключа
 * (раздел 7 ТЗ). Метка ставится геокодером Яндекса по адресу, поэтому
 * координаты в коде не хранятся и не могут разойтись с реальностью.
 *
 * Для карты с несколькими метками сразу заказчик собирает её в конструкторе
 * (yandex.ru/map-constructor) и кладёт ссылку в `maps` в src/data/site.ts —
 * тогда `constructorUrl` перекрывает поиск по адресу. Инструкция — в README.
 */
interface Props {
  /** Готовая ссылка из конструктора Яндекс.Карт (приоритетнее адреса) */
  constructorUrl?: string | null;
  /** Адрес для поиска, например «Челябинск, улица Карпинского, 62» */
  query?: string;
  zoom?: number;
  title: string;
  height?: number;
}

const { constructorUrl, query, zoom = 17, title, height = 460 } = Astro.props;

const src =
  constructorUrl ||
  `https://yandex.ru/map-widget/v1/?mode=search&text=${encodeURIComponent(query ?? '')}&z=${zoom}`;
---

<div class="map" style={`--map-h:${height}px`}>
  <iframe
    src={src}
    title={title}
    width="100%"
    height={height}
    loading="lazy"
    allowfullscreen
  ></iframe>
</div>

<style>
  .map {
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--c-surface);
    line-height: 0;
  }
  .map iframe {
    display: block;
    width: 100%;
    height: var(--map-h);
    border: 0;
  }
  @media (max-width: 767px) {
    .map iframe { height: 340px; }
  }
</style>
