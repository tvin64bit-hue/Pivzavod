---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import LeadForm from '../../components/LeadForm.astro';
import { contacts } from '../../data/site';
---

<BaseLayout
  title="Пивные SPA-процедуры"
  description="Пивные SPA-процедуры в Челябинске: две ванны с живым пивом, инфракрасная сауна и массаж. Процедура длится 1,5 часа. Запись по телефону или через форму."
>
  <PageHeader
    label="Впечатления"
    title="Пивные SPA-процедуры"
    lead="Две ванны рядом, полтора часа и кружка живого пива в руке. Процедура для тех, кто уже всё попробовал на вкус."
    crumbs={[{ label: 'Впечатления', href: '/opyt' }, { label: 'Пивные SPA-процедуры' }]}
  />

  <section class="section">
    <div class="container spa-layout">
      <div>
        <div class="prose">
          <p class="label">Что это</p>
          <p>
            В клубе мини-пивоварни «Лаборатория пива» гости могут воспользоваться
            новой необычной процедурой — поплескаться в ванне с пивом. Гостям
            предлагаются две ванны, расположенные рядом друг с другом, где гости
            могут лежать в пиве, синхронно наслаждаясь кружкой этого прекрасного
            напитка.
          </p>
        </div>

        <div class="spa-steps">
          <p class="label">Как проходит</p>
          <ol>
            <li>Душ.</li>
            <li>
              Инфракрасная сауна — тело разогревается, организм пропотеет
              и расслабится.
            </li>
            <li>Ещё раз душ.</li>
            <li>И только после этого — сама пивная ванна.</li>
            <li>
              Массаж на отдельные части тела или общий расслабляющий —
              рекомендуется для полного эффекта, выполняет опытный специалист.
            </li>
          </ol>
        </div>

        <dl class="spa-specs">
          <div class="spa-spec">
            <dt>Длительность</dt>
            <dd>1,5 часа</dd>
          </div>
          <div class="spa-spec">
            <dt>Ванны</dt>
            <dd>две, рядом друг с другом</dd>
          </div>
          <div class="spa-spec">
            <dt>Массаж</dt>
            <dd>по желанию, отдельные части тела или общий</dd>
          </div>
          <div class="spa-spec">
            <dt>Стоимость</dt>
            <dd class="spa-spec--empty">уточняется по телефону</dd>
          </div>
          <div class="spa-spec">
            <dt>Противопоказания</dt>
            <dd class="spa-spec--empty">уточняются</dd>
          </div>
        </dl>

        <p class="prose spa-call">
          Записаться и узнать стоимость:
          <a href={contacts.officePhone.href} class="spa-phone mono">{contacts.officePhone.label}</a>
        </p>

      </div>

      <LeadForm
        topic="tour"
        title="Записаться на процедуру"
        description="Оставьте контакты — расскажем про стоимость, ограничения и свободное время."
        source="Пивные SPA-процедуры"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .spa-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-12);
    align-items: start;
  }
  .spa-phone { font-size: 20px; text-decoration: none; }
  .spa-call { margin-top: var(--s-8); }

  .spa-steps { margin-top: var(--s-8); }
  .spa-steps ol {
    counter-reset: step;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .spa-steps li {
    counter-increment: step;
    position: relative;
    padding-left: var(--s-8);
    margin-bottom: var(--s-3);
    font-size: 15px;
    line-height: 24px;
  }
  .spa-steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 1px;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--c-accent);
  }
  .spa-note { margin-top: var(--s-8); }

  .spa-specs { margin: var(--s-8) 0 0; border-top: 1px solid var(--c-border); }
  .spa-spec {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--c-border);
  }
  .spa-spec dt {
    font-family: var(--f-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-muted);
  }
  .spa-spec dd { margin: 0; font-size: 14px; }
  .spa-spec--empty {
    font-family: var(--f-mono);
    color: var(--c-ochre);
    font-size: 13px;
  }

  @media (max-width: 1023px) {
    .spa-layout { grid-template-columns: minmax(0, 1fr); gap: var(--s-8); }
  }
</style>
