---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import LeadForm from '../../components/LeadForm.astro';
import { vacancy } from '../../data/content';
---

<BaseLayout
  title="Вакансии"
  description="Открытые вакансии «Лаборатории живого пива» в Челябинске: водитель-экспедитор. Условия, требования и форма отклика."
>
  <PageHeader
    label="О компании"
    title="Вакансии"
    lead="Открытые позиции в «Лаборатории живого пива»."
    crumbs={[{ label: 'О компании', href: '/o-kompanii' }, { label: 'Вакансии' }]}
  />

  <section class="section">
    <div class="container vacancy-wrap">
      <article class="card vacancy">
        <p class="label">Открытая вакансия</p>
        <h2>{vacancy.title}</h2>

        <dl class="vacancy__rows">
          {vacancy.rows.map(([k, v]) => (
            <div class="vacancy__row">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>

        <h3 class="vacancy__req-title">Требования</h3>
        <p class="caption">{vacancy.requirements}</p>

        <a class="btn btn--primary vacancy__cta" href="#otklik">Откликнуться</a>
      </article>

      <p class="placeholder-note">
        <strong>Требует подтверждения заказчика</strong>
        Вакансия перенесена с сайта-донора и не проверялась на актуальность
        (пункт «Актуальность вакансий — [УТОЧНИТЬ]» из чек-листа ассетов ТЗ).
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <LeadForm
        id="otklik"
        topic="other"
        title="Откликнуться на вакансию"
        description="Оставьте контакты — перезвоним и обсудим детали. В комментарии коротко напишите про опыт."
        source="Вакансии: водитель-экспедитор"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .vacancy-wrap { max-width: 820px; }
  .vacancy h2 { font-size: 32px; line-height: 40px; margin-bottom: var(--s-8); }

  .vacancy__rows { margin: 0 0 var(--s-8); border-top: 1px solid var(--c-border); }
  .vacancy__row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--s-4);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--c-border);
  }
  .vacancy__row dt {
    font-family: var(--f-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-muted);
    padding-top: 4px;
  }
  .vacancy__row dd { margin: 0; font-size: 15px; }

  .vacancy__req-title {
    font-family: var(--f-mono);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-accent);
    margin-bottom: var(--s-3);
  }
  .vacancy__cta { margin-top: var(--s-8); }

  @media (max-width: 767px) {
    .vacancy h2 { font-size: 26px; line-height: 34px; }
    .vacancy__row { grid-template-columns: minmax(0, 1fr); gap: var(--s-1); }
    .vacancy__cta { width: 100%; }
  }
</style>
