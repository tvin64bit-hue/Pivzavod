# Настройки сайта: почта для заявок и вход в админку.
# На сервере кладётся в /etc/pivzavod74.env
# и закрывается от посторонних:
#
#   sudo cp deploy/pivzavod74.env.example /etc/pivzavod74.env
#   sudo nano /etc/pivzavod74.env
#   sudo chown root:www-data /etc/pivzavod74.env
#   sudo chmod 640 /etc/pivzavod74.env
#
# В git этот файл с реальными значениями попадать не должен.

# Кому приходят заявки. Несколько адресов — через запятую.
MAIL_TO=

# Ящик, от имени которого отправляем. Для Яндекс 360:
#   SMTP_HOST=smtp.yandex.ru
#   SMTP_PORT=465
# Для Mail.ru для бизнеса:
#   SMTP_HOST=smtp.mail.ru
#   SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=

# Именно пароль приложения, а не пароль от аккаунта: у Яндекса и Mail.ru
# обычный пароль для SMTP не работает при включённой двухфакторке.
SMTP_PASS=

# Необязательно: если отправитель отличается от логина.
# Адрес всё равно должен принадлежать тому же домену, иначе письмо уйдёт в спам.
# MAIL_FROM="Сайт Лаборатории живого пива <zayavki@pivzavod74.ru>"

# Необязательно: отсекает запросы к форме с чужих сайтов
ALLOWED_ORIGIN=https://pivzavod74.ru

# ── Админка ─────────────────────────────────────────────────────────────────
#
# Эти три строки выдаёт `node scripts/admin-password.mjs` — он же придумает
# пароль, если не задать свой. Сам пароль нигде не хранится: в файл идёт
# только хеш, восстановить из него пароль нельзя. Забыли — сгенерируйте заново.
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# ── Пути ────────────────────────────────────────────────────────────────────
#
# Записи и фотографии, созданные через админку. В git не попадают,
# при выкладке новой версии сайта не затираются — их и надо бэкапить.
DATA_DIR=/srv/pivzavod74/data

# Симлинк на текущую сборку — сюда смотрит nginx
WEB_ROOT=/var/www/pivzavod74/current
# Каталог со сборками; храним три последних, чтобы было куда откатиться
RELEASES_DIR=/var/www/pivzavod74/releases

# Порт, который слушает сервис. Наружу не смотрит — только nginx.
PORT=8787
