# Переменные окружения обработчика формы заявки (functions/api/lead.ts).
# В Cloudflare Pages задаются в Settings → Variables and Secrets,
# токен — обязательно как Secret, а не как обычная переменная.
# Локально для `wrangler pages dev` скопируйте файл в .dev.vars.

# Токен бота от @BotFather — [ЗАПОЛНИТЬ заказчику]
TELEGRAM_BOT_TOKEN=

# ID чата, группы или канала, куда падают заявки — [ЗАПОЛНИТЬ заказчику]
# Узнать: добавьте бота в группу и откройте
# https://api.telegram.org/bot<TOKEN>/getUpdates — id будет в message.chat.id
TELEGRAM_CHAT_ID=

# Необязательно: точный Origin сайта. Если задан, запросы с чужих Origin отклоняются.
# ALLOWED_ORIGIN=https://pivzavod74.ru

# Необязательно: канонический домен для сборки (по умолчанию https://pivzavod74.ru)
# SITE_URL=https://pivzavod74.ru
