# Настройки для локального запуска: npm run local
#
# Скопируйте этот файл в .env (он в git не попадает) и заполните.
# На сервере то же самое лежит в /etc/pivzavod74.env — см. deploy/README.md.

# ── Админка ─────────────────────────────────────────────────────────────────
#
# Три строки выдаёт: node scripts/admin-password.mjs 'ваш-пароль'
# Пароль нигде не хранится — только хеш, восстановить его нельзя.
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# ── Почта для заявок ────────────────────────────────────────────────────────
#
# Необязательно. Без этого сайт и админка работают, а форма заявки честно
# отвечает «не удалось отправить» и предлагает позвонить.
# MAIL_TO=
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# ── Пути ────────────────────────────────────────────────────────────────────
#
# Значения по умолчанию годятся: данные админки лягут в ./data,
# сборка — в ./dist, промежуточные сборки — в ./.releases.
# DATA_DIR=./data
# WEB_ROOT=./dist
# PORT=4321
